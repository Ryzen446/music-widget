<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Widget"
        Width="384"
        Height="258"
        MinWidth="320"
        MinHeight="76"
        MaxWidth="650"
        MaxHeight="750"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FF000000"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#FF2C2C2C"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FFA8A8A8"/>
        <SolidColorBrush x:Key="TileBrush" Color="#FF181818"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#FF373737"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FF000000"/>
        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/></Style>
        <Style TargetType="Control" x:Key="FocusRing">
            <Setter Property="Template"><Setter.Value><ControlTemplate><Rectangle Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" RadiusX="6" RadiusY="6" Margin="2"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <SolidColorBrush x:Key="PlayBrush" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="PlayBorderBrush" Color="#77FFFFFF"/>
        <SolidColorBrush x:Key="PlayReflectionBrush" Color="#10FFFFFF"/>
        <SolidColorBrush x:Key="MenuSurfaceBrush" Color="#FF202024"/>
        <SolidColorBrush x:Key="MenuHoverBrush" Color="#FF3C3C43"/>
        <SolidColorBrush x:Key="MenuBorderBrush" Color="#FF5A5A63"/>
        <Style TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#FFF5F5F7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                <Grid>
                    <Border x:Name="MenuItemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Foreground="#FFBCBCC4" Margin="18,0,5,0" VerticalAlignment="Center" FontSize="10"/>
                            <Path x:Name="SubmenuArrow" Grid.Column="2" Data="M0,0 L4,4 L0,8" Stroke="#FFF5F5F7" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Placement="Right" HorizontalOffset="4" VerticalOffset="-5" AllowsTransparency="True" Focusable="False">
                        <Border x:Name="SubmenuSurface" Background="{DynamicResource MenuSurfaceBrush}" BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="5" MinWidth="180"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="HasItems" Value="True"><Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuItemSurface" Property="Background" Value="{DynamicResource MenuHoverBrush}"/></Trigger>
                    <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="MenuItemSurface" Property="Background" Value="{DynamicResource MenuHoverBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#FF9999A3"/><Setter TargetName="SubmenuArrow" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="#FF505058" Margin="10,5"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#FFF5F5F7"/>
            <Setter Property="Background" Value="{DynamicResource MenuSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
                <Border x:Name="ContextSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="5" MinWidth="220"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <!-- iOS Dark Glass ToolTip Style -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#E61C1C1E"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="7,3.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.35" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom iOS Slim ScrollBar Style -->
        <Style x:Key="IOSScrollBarThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumbBorder" Background="#3A3A3E" CornerRadius="2.5" Width="4.5" HorizontalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#5A5A60"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#71717A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" HorizontalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource IOSScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS Main Play Button -->
        <Style x:Key="PlayMainBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource PlayBorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="23" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Grid><Border CornerRadius="23" Background="{DynamicResource PlayReflectionBrush}" IsHitTestVisible="False"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS Secondary Media Button -->
        <Style x:Key="MediaCircleBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#35FFFFFF"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.90" ScaleY="0.90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Icon Button -->
        <Style x:Key="MiniIconBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#20888888"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#38888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS Volume Slider Style -->
        <Style x:Key="IOSVolumeSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border x:Name="bgTrack" Height="4.5" CornerRadius="2.25" Background="{DynamicResource TrackBrush}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border x:Name="fillTrack" Height="4.5" CornerRadius="2.25,0,0,2.25" Background="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4.5" CornerRadius="0,2.25,2.25,0" Background="Transparent" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="11" Height="11" CornerRadius="5.5" Background="{DynamicResource TextBrush}" Cursor="Hand">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.3" Color="#000000"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS Track Progress Scrubber Style -->
        <Style x:Key="IOSProgressSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Background="Transparent">
                            <Border x:Name="progBgTrack" Height="3.5" CornerRadius="1.75" Background="{DynamicResource TrackBrush}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3.5" CornerRadius="1.75,0,0,1.75" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3.5" CornerRadius="0,1.75,1.75,0" Background="Transparent" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="9" Height="9" CornerRadius="4.5" Background="{DynamicResource TextBrush}" Cursor="Hand">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.35" Color="#000000"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Invisible Resize Border Thumb Style -->
        <Style x:Key="ResizeThumbTransparent" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS Glass Modal Confirm Buttons -->
        <Style x:Key="ModalBtnCancel" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#28FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#35FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModalBtnDelete" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#CCFF2D55"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="12" RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.45" Color="#FF2D55"/>
                            </Border.Effect>
                            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS Squircle Option Card Button (For Upload Source / Platform Choices) -->
        <Style x:Key="UploadOptionBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#24FFFFFF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#35FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#32FFFFFF"/>
                                <Setter TargetName="bg" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Download Button -->
        <Style x:Key="UploadActionBtn" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="12" RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.45" Color="#007AFF"/>
                            </Border.Effect>
                            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern iOS TextBox Style -->
        <Style x:Key="IOSTextBoxStyle" TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource TileBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern iOS Progress Bar Style -->
        <Style x:Key="IOSProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="#25FFFFFF"/>
            <Setter Property="Foreground" Value="#007AFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border CornerRadius="2" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="5"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource TileBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
                <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False" Foreground="{DynamicResource TextBrush}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource TileBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="9,5"><Grid><ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Margin="0,0,13,0" VerticalAlignment="Center"/><Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource ModalSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="140" Margin="0,3,0,0"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup>
            </Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <!-- Root Grid: player + delete modal + upload modal stacked -->
    <Grid x:Name="RootGrid">

        <Border x:Name="MinimalCard" Margin="0" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Visibility="Collapsed">
            <Grid>
                <Border x:Name="MinimalReflection" CornerRadius="8" IsHitTestVisible="False" Visibility="Collapsed"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#28FFFFFF" Offset="0"/><GradientStop Color="#02FFFFFF" Offset="0.45"/><GradientStop Color="#12FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                <Border x:Name="MinimalSpecular" CornerRadius="8" IsHitTestVisible="False" Opacity="0"><Border.Background><RadialGradientBrush RadiusX="0.6" RadiusY="1.4" Center="0.3,0" GradientOrigin="0.3,0"><GradientStop Color="#30FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Border.Background></Border>
                <Grid Margin="12,3">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="11"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/><ColumnDefinition Width="35"/><ColumnDefinition Width="35"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="MinimalTitle" Text="{DynamicResource i.emptyTitle}" Foreground="{DynamicResource TextBrush}" Margin="0,0,8,0" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Button x:Name="BtnMinimalMute" Style="{StaticResource MiniIconBtn}" Grid.Column="1" Width="28" Height="28" AutomationProperties.Name="{DynamicResource i.adjustVolume}"><Grid><Path x:Name="MinimalSpeaker" Data="M1,6 H4 L8,2 V16 L4,12 H1 Z M11,5 Q16,9 11,13" Stroke="{DynamicResource TextBrush}" Fill="{DynamicResource TextBrush}" StrokeThickness="1" Width="11" Height="11" Stretch="Uniform"/><Path x:Name="MinimalMuted" Data="M1,6 H4 L8,2 V16 L4,12 H1 Z M11,6 L16,12 M16,6 L11,12" Stroke="{DynamicResource TextBrush}" Fill="{DynamicResource TextBrush}" StrokeThickness="1" Width="11" Height="11" Stretch="Uniform" Visibility="Collapsed"/></Grid></Button>
                    <Popup x:Name="MinimalVolumePopup" Grid.Column="1" PlacementTarget="{Binding ElementName=BtnMinimalMute}" Placement="Bottom" VerticalOffset="5" HorizontalOffset="-90" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="#F0252731" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="13" Padding="10" Width="216">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource i.volume}" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                                    <Button x:Name="BtnMinimalPopupMute" Style="{StaticResource MiniIconBtn}" Foreground="{DynamicResource TextBrush}" Height="23" Margin="0,0,5,0" Content="{DynamicResource i.muted}"/>
                                    <Slider x:Name="MinimalPopupSlider" Grid.Column="1" Minimum="0" Maximum="100" Style="{StaticResource IOSVolumeSlider}" VerticalAlignment="Center" IsMoveToPointEnabled="True" AutomationProperties.Name="{DynamicResource i.volume}"/>
                                    <TextBlock x:Name="MinimalPopupLevel" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontSize="10" Text="20%"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button x:Name="BtnMinimalPlay" Grid.Column="2" Style="{StaticResource MiniIconBtn}" Width="28" Height="28" VerticalAlignment="Center" Background="{DynamicResource PlayBrush}" AutomationProperties.Name="{DynamicResource i.playPause}"><Grid><Path x:Name="MinimalIconPlay" Data="M6,3 L20,12 L6,21 Z" Fill="{DynamicResource AccentTextBrush}" Width="10" Height="12" Stretch="Uniform" Margin="2,0,0,0"/><Path x:Name="MinimalIconPause" Data="M4,3 H9 V21 H4 Z M15,3 H20 V21 H15 Z" Fill="{DynamicResource AccentTextBrush}" Width="10" Height="12" Stretch="Uniform" Visibility="Collapsed"/></Grid></Button>
                    <Button x:Name="BtnMinimalNext" Grid.Column="3" Style="{StaticResource MiniIconBtn}" Width="28" Height="28" AutomationProperties.Name="{DynamicResource i.next}"><Path Data="M4,4 L14,12 L4,20 Z M16,4 H19 V20 H16 Z" Fill="{DynamicResource TextBrush}" Width="11" Height="11" Stretch="Uniform"/></Button>
                    <Button x:Name="BtnMinimalMenu" Grid.Column="4" Style="{StaticResource MiniIconBtn}" Width="28" Height="28" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource i.options}"><Path Data="M2,4 A1,1 0 1 0 4,4 A1,1 0 1 0 2,4 M8,4 A1,1 0 1 0 10,4 A1,1 0 1 0 8,4 M14,4 A1,1 0 1 0 16,4 A1,1 0 1 0 14,4" Fill="{DynamicResource TextBrush}" Width="12" Height="3" Stretch="Uniform"/></Button>
                </Grid>
                <ProgressBar x:Name="MinimalProgressBar" VerticalAlignment="Bottom" Style="{StaticResource IOSProgressBarStyle}" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="{DynamicResource i.trackPosition}"/>
            </Grid>
        </Border>

        <!-- === MAIN PLAYER CARD === -->
        <Border x:Name="MainCard" Margin="0" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}">
            
            <Grid><Border x:Name="MainReflection" CornerRadius="8" IsHitTestVisible="False" Visibility="Collapsed"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#18FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.55"/></LinearGradientBrush></Border.Background></Border><Grid x:Name="PlayerLayout" Margin="18,12,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
                <Grid x:Name="HeaderRow" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource i.music}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="TxtDesignLabel" Text="" FontSize="9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-3,-5,-3">
                        <Button x:Name="BtnTheme" Style="{StaticResource MiniIconBtn}" ToolTip="{DynamicResource i.appearance}" AutomationProperties.Name="{DynamicResource i.appearance}">
                            <Path x:Name="IconTheme" Data="M12,2 A10,10 0 1 0 12,22 H14 A3,3 0 0 0 14,16 H13 A1.5,1.5 0 0 1 13,13 H16 A6,6 0 0 0 12,2 Z" Stroke="{DynamicResource MutedBrush}" Fill="Transparent" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="BtnPlaylist" Style="{StaticResource MiniIconBtn}" ToolTip="{DynamicResource i.nativeLibraryShortcut}" AutomationProperties.Name="{DynamicResource i.openLibrary}">
                            <Path x:Name="IconPlaylist" Data="M3,5 H19 M3,11 H15 M3,17 H11 M17,15 L21,18 L17,21 Z" Stroke="{DynamicResource MutedBrush}" Fill="{DynamicResource MutedBrush}" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="BtnHide" Style="{StaticResource MiniIconBtn}" ToolTip="{DynamicResource i.hideWidget}" AutomationProperties.Name="{DynamicResource i.hideWidget}">
                            <Path x:Name="IconHide" Data="M3,10 H19 V12 H3 Z" Fill="{DynamicResource MutedBrush}" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid x:Name="TrackRow" Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="PnlWaveBox" Width="48" Height="48" CornerRadius="15" Background="{DynamicResource TileBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                        <Grid>
                            <Grid x:Name="DiscArt" Visibility="Collapsed" Margin="5" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><RotateTransform x:Name="DiscRotation"/></Grid.RenderTransform>
                                <Ellipse Fill="#FF101218" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1"/>
                                <Ellipse Margin="7" Stroke="#405F6470"/><Ellipse Margin="13" Stroke="#405F6470"/>
                                <Ellipse Margin="20" Fill="{DynamicResource AccentBrush}"/><Ellipse Width="5" Height="5" Fill="#FF101218"/>
                            </Grid>
                            <StackPanel x:Name="WavePanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border x:Name="WaveBar1" Width="3" Height="28" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Margin="1.5,0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleY="0.2"/></Border.RenderTransform></Border>
                                <Border x:Name="WaveBar2" Width="3" Height="28" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Margin="1.5,0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleY="0.4"/></Border.RenderTransform></Border>
                                <Border x:Name="WaveBar3" Width="3" Height="28" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Margin="1.5,0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleY="0.7"/></Border.RenderTransform></Border>
                                <Border x:Name="WaveBar4" Width="3" Height="28" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Margin="1.5,0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleY="0.4"/></Border.RenderTransform></Border>
                                <Border x:Name="WaveBar5" Width="3" Height="28" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Margin="1.5,0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleY="0.2"/></Border.RenderTransform></Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="TrackMetadata" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Grid x:Name="TitleContainer" ClipToBounds="True" Height="23">
                            <Canvas x:Name="TitleCanvas" Height="23"><TextBlock x:Name="TxtTitle" Text="{DynamicResource i.emptyTitle}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextBrush}" TextWrapping="NoWrap"><TextBlock.RenderTransform><TranslateTransform x:Name="TitleTransform"/></TextBlock.RenderTransform></TextBlock></Canvas>
                        </Grid>
                        <TextBlock x:Name="TxtSubtitle" Text="{DynamicResource i.emptySubtitle}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="TimelineRow" Grid.Row="2" Margin="0,0,0,4">
                    <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="15"/></Grid.RowDefinitions>
                    <Slider x:Name="ProgressSlider" Style="{StaticResource IOSProgressSlider}" Minimum="0" Maximum="100" Value="0" IsMoveToPointEnabled="True" SmallChange="1" AutomationProperties.Name="{DynamicResource i.trackPosition}"/>
                    <TextBlock x:Name="TxtCurrentTime" Grid.Row="1" Text="0:00" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock x:Name="TxtStatus" Grid.Row="1" Text="{DynamicResource i.ready}" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="TxtTotalTime" Grid.Row="1" Text="0:00" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
                </Grid>
                <StackPanel x:Name="PlaybackRow" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,8">
                    <Button x:Name="BtnShuffle" Style="{StaticResource MiniIconBtn}" Margin="0,0,16,0" ToolTip="{DynamicResource i.shuffleOff}" AutomationProperties.Name="{DynamicResource i.shuffle}">
                        <Path x:Name="IconShuffle" Data="M3,5 H6 L18,19 H22 M18,15 L22,19 L18,23 M3,19 H6 L18,5 H22 M18,1 L22,5 L18,9" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnPrev" Style="{StaticResource MediaCircleBtn}" Margin="0,0,16,0" ToolTip="{DynamicResource i.nativePrevShortcut}" AutomationProperties.Name="{DynamicResource i.previous}"><Path x:Name="IconPrev" Data="M4,4 H6 V20 H4 Z M8,12 L21,20 V4 Z" Fill="{DynamicResource TextBrush}" Width="15" Height="15" Stretch="Uniform"/></Button>
                    <Button x:Name="BtnPlay" Style="{StaticResource PlayMainBtn}" Margin="0,0,16,0" ToolTip="{DynamicResource i.nativePlayShortcut}" AutomationProperties.Name="{DynamicResource i.playPause}">
                        <Grid><Path x:Name="IconPlay" Data="M6,3 L20,12 L6,21 Z" Fill="{DynamicResource AccentTextBrush}" Width="15" Height="17" Stretch="Uniform" Margin="3,0,0,0"/><Path x:Name="IconPause" Data="M4,3 H9 V21 H4 Z M15,3 H20 V21 H15 Z" Fill="{DynamicResource AccentTextBrush}" Width="14" Height="17" Stretch="Uniform" Visibility="Collapsed"/></Grid>
                    </Button>
                    <Button x:Name="BtnNext" Style="{StaticResource MediaCircleBtn}" Margin="0,0,16,0" ToolTip="{DynamicResource i.nativeNextShortcut}" AutomationProperties.Name="{DynamicResource i.next}"><Path x:Name="IconNext" Data="M3,4 L16,12 L3,20 Z M18,4 H20 V20 H18 Z" Fill="{DynamicResource TextBrush}" Width="15" Height="15" Stretch="Uniform"/></Button>
                    <Button x:Name="BtnRepeat" Style="{StaticResource MiniIconBtn}" ToolTip="{DynamicResource i.repeat}" AutomationProperties.Name="{DynamicResource i.repeat}"><Grid><Path x:Name="IconRepeat" Data="M5,7 H19 V11 L23,6 L19,1 V5 H3 V12 H5 Z M19,17 H5 V13 L1,18 L5,23 V19 H21 V12 H19 Z" Fill="{DynamicResource MutedBrush}" Width="16" Height="16" Stretch="Uniform"/><TextBlock x:Name="RepeatOneBadge" Text="1" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"/></Grid></Button>
                </StackPanel>
                <Grid x:Name="VolumeRow" Grid.Row="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                    <Button x:Name="BtnMute" Style="{StaticResource MiniIconBtn}" ToolTip="{DynamicResource i.nativeMuteShortcut}" AutomationProperties.Name="{DynamicResource i.volumeToggle}"><Grid><Path x:Name="IconSpeaker" Data="M2,8 H6 L12,3 V21 L6,16 H2 Z M16,7 Q23,12 16,17" Fill="{DynamicResource MutedBrush}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"/><Path x:Name="IconMuted" Data="M2,8 H6 L12,3 V21 L6,16 H2 Z M16,8 L23,16 M23,8 L16,16" Stroke="{DynamicResource AccentBrush}" Fill="{DynamicResource AccentBrush}" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" Visibility="Collapsed"/></Grid></Button>
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource IOSVolumeSlider}" Minimum="0" Maximum="100" Value="20" IsMoveToPointEnabled="True" AutomationProperties.Name="{DynamicResource i.volume}"/>
                    <TextBlock x:Name="TxtVolumePercent" Grid.Column="2" Text="20%" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Grid x:Name="PlaylistDrawer" Grid.Row="5" Grid.ColumnSpan="2" Height="0" ClipToBounds="True" Margin="0,8,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border x:Name="DrawerDivider" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardBorderBrush}" Padding="0,10,0,8">
                        <Grid><TextBlock x:Name="TxtPlaylistCount" Text="{DynamicResource i.library}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnRefreshLibrary" Style="{StaticResource MiniIconBtn}" ToolTip="{DynamicResource i.refreshLibrary}" AutomationProperties.Name="{DynamicResource i.refreshLibrary}"><Path Data="M19,7 A8,8 0 1 0 20,16 M19,2 V8 H13" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Width="13" Height="13" Stretch="Uniform"/></Button>
                                <Button x:Name="BtnNewPlaylist" Style="{StaticResource MiniIconBtn}" ToolTip="{DynamicResource i.newPlaylist}" AutomationProperties.Name="{DynamicResource i.newPlaylist}"><Path x:Name="IconNewPlaylist" Data="M2,4 H16 M2,10 H12 M2,16 H10 M18,12 V22 M13,17 H23" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform"/></Button>
                                <Button x:Name="BtnAddMusic" Style="{StaticResource MiniIconBtn}" ToolTip="{DynamicResource i.addMusic}" AutomationProperties.Name="{DynamicResource i.addMusic}"><Path x:Name="IconAddMusic" Data="M12,3 V21 M3,12 H21" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform"/></Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ScrollViewer x:Name="PlaylistShelfScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,6"><StackPanel x:Name="PlaylistShelfContainer" Orientation="Horizontal"/></ScrollViewer>
                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="TrackListContainer" Margin="0,0,4,0"/></ScrollViewer>
                        <TextBlock x:Name="EmptyLibraryHint" Text="{DynamicResource i.emptyLibraryHint}" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="12" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
            </Grid></Grid>
        </Border>


<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="AppearanceOverlay" Visibility="Collapsed" Background="#60000000" Margin="0">
    <Border Background="{DynamicResource ModalSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16" MaxWidth="440" VerticalAlignment="Stretch">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,12"><StackPanel><TextBlock Text="{DynamicResource i.settings}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="{DynamicResource i.appearance}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel><Button x:Name="BtnAppearanceClose" Style="{DynamicResource MiniIconBtn}" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="{DynamicResource i.closeSettings}" AutomationProperties.Name="{DynamicResource i.closeSettings}"><TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource TextBrush}"/></Button></Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,5,0">
                    <TextBlock Text="{DynamicResource i.layout}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                    <UniformGrid x:Name="DesignOptions" Rows="1" Columns="2" Margin="-3,0,-3,16"/>
                    <TextBlock Text="{DynamicResource i.theme}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                    <UniformGrid x:Name="PaletteOptions" Columns="2" Margin="-3,0,-3,12"/>
                    <StackPanel x:Name="PositionSettings" Margin="0,0,0,14" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource i.minimalPosition}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                        <ComboBox x:Name="PositionOptions" Height="30" AutomationProperties.Name="{DynamicResource i.minimalPosition}"/>
                        <TextBlock Text="{DynamicResource i.rightClickHint}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource i.playback}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="PlaybackSpeedOptions" Height="29" Margin="0,0,5,0" ToolTip="{DynamicResource i.playbackSpeed}" AutomationProperties.Name="{DynamicResource i.playbackSpeed}"/><ComboBox x:Name="SleepOptions" Grid.Column="1" Height="29" Margin="5,0,0,0" ToolTip="{DynamicResource i.sleep}" AutomationProperties.Name="{DynamicResource i.sleep}"/></Grid>
                    <CheckBox x:Name="PinOption" Content="{DynamicResource i.alwaysOnTop}" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,5"/>
                    <CheckBox x:Name="ReducedMotionOption" Content="{DynamicResource i.reducedMotion}" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,5"/>
                    <TextBlock Text="{DynamicResource i.nativeKeyboardHint}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Grid>

        <!-- Resize Thumbs -->
        <Thumb x:Name="RightResizeThumb" Width="8" HorizontalAlignment="Right"
               VerticalAlignment="Stretch" Margin="0,16,0,16" Cursor="SizeWE"
               Style="{StaticResource ResizeThumbTransparent}"/>
        <Thumb x:Name="BottomResizeThumb" Height="8" HorizontalAlignment="Stretch"
               VerticalAlignment="Bottom" Margin="16,0,16,0" Cursor="SizeNS"
               Style="{StaticResource ResizeThumbTransparent}"/>
        <Thumb x:Name="ResizeGripThumb" Width="18" Height="18"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,8,8" Cursor="SizeNWSE">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M 12,4 L 4,12 M 12,8 L 8,12 M 12,12 L 12,12"
                              Stroke="#40888888" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- === DELETE CONFIRMATION MODAL OVERLAY === -->
        <Grid x:Name="ModalOverlay" Visibility="Collapsed" Panel.ZIndex="100" UseLayoutRounding="True" SnapsToDevicePixels="True">
            <!-- Clean dark scrim -->
            <Border x:Name="ModalBackdrop"
                    Background="#B8000000"
                    CornerRadius="22"
                    Margin="12"
                    IsHitTestVisible="True"/>

            <!-- Modal Card (Crisp solid iOS squircle, 100% sharp text) -->
            <Border x:Name="ModalCard"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="220"
                    MaxWidth="290"
                    Margin="24,0"
                    CornerRadius="20"
                    Background="{DynamicResource ModalSurfaceBrush}"
                    BorderBrush="#38FFFFFF"
                    BorderThickness="1"
                    Padding="18,16,18,16"
                    UseLayoutRounding="True"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.5" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Warning icon circle -->
                    <Border Width="38" Height="38" CornerRadius="23" Background="#28FF453A" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Path Data="M 6,19 C 6,20.1 6.9,21 8,21 H 16 C 17.1,21 18,20.1 18,19 V 7 H 6 V 19 Z M 19,4 H 15.5 L 14.5,3 H 9.5 L 8.5,4 H 5 V 6 H 19 V 4 Z"
                              Fill="#FF453A" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title -->
                    <TextBlock Text="{DynamicResource i.deleteTrackQuestion}"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextBrush}" TextAlignment="Center"
                               Margin="0,0,0,4"/>

                    <!-- Track name to delete -->
                    <TextBlock x:Name="ModalTrackName" Text="{DynamicResource i.trackName}"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="11" Foreground="#FF2D55"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               FontWeight="Medium"
                               Margin="0,0,0,4"/>

                    <!-- Warning subtitle -->
                    <TextBlock Text="{DynamicResource i.nativeDeleteDescription}"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="10.5" Foreground="{DynamicResource MutedBrush}"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,0,0,16"/>

                    <!-- Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnModalCancel" Grid.Column="0" Style="{StaticResource ModalBtnCancel}" Content="{DynamicResource i.cancel}"/>
                        <Button x:Name="BtnModalDelete" Grid.Column="2" Style="{StaticResource ModalBtnDelete}" Background="#CCFF2D55" Content="{DynamicResource i.delete}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- === MULTI-SOURCE UPLOAD MODAL OVERLAY (Local Downloads vs Auto-Detecting URL) === -->
        <Grid x:Name="UploadOverlay" Visibility="Collapsed" Panel.ZIndex="110" UseLayoutRounding="True" SnapsToDevicePixels="True">
            <!-- Backdrop Scrim -->
            <Border x:Name="UploadModalBackdrop"
                    Background="#C8000000"
                    CornerRadius="22"
                    Margin="12"
                    IsHitTestVisible="True"/>

            <!-- Main Upload Modal Card -->
            <Border x:Name="UploadModalCard"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="265"
                    MaxWidth="315"
                    Margin="16,0"
                    CornerRadius="20"
                    Background="{DynamicResource ModalSurfaceBrush}"
                    BorderBrush="#38FFFFFF"
                    BorderThickness="1"
                    Padding="16,14,16,14"
                    UseLayoutRounding="True"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.5" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header Bar (Back button, Title, Close button) -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Back Button (shown only on Step 2) -->
                        <Button x:Name="BtnUploadBack" Grid.Column="0" Style="{StaticResource MiniIconBtn}" ToolTip="{DynamicResource i.back}" Visibility="Collapsed" Margin="-4,0,4,0">
                            <Path Data="M 14,4 L 6,10 L 14,16" Stroke="#A1A1AA" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="12" Stretch="Uniform"/>
                        </Button>

                        <!-- Header Title -->
                        <TextBlock x:Name="TxtUploadHeader" Grid.Column="1"
                                   Text="{DynamicResource i.addMusic}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextBrush}" TextAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <!-- Close Button -->
                        <Button x:Name="BtnUploadClose" Grid.Column="2" Style="{StaticResource MiniIconBtn}" ToolTip="{DynamicResource i.close}" Margin="4,0,-4,0">
                            <Path Data="M 4,4 L 16,16 M 16,4 L 4,16" Stroke="#A1A1AA" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <!-- STEP 1: Main Source Selection (Downloads vs URL) -->
                    <StackPanel x:Name="PnlUploadStep1" Visibility="Visible">
                        <!-- Option A: Local Downloads Folder -->
                        <Button x:Name="BtnChoiceLocal" Style="{StaticResource UploadOptionBtn}" Margin="0,0,0,8" ToolTip="{DynamicResource i.downloadFolderSelect}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Icon Box -->
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10" Background="#25007AFF" Margin="0,0,10,0">
                                    <Path Data="M 19.35,10.04 C 18.67,6.59 15.64,4 12,4 C 9.11,4 6.6,5.64 5.35,8.04 C 2.34,8.36 0,10.91 0,14 C 0,17.31 2.69,20 6,20 H 19 C 21.76,20 24,17.76 24,15 C 24,12.36 21.95,10.22 19.35,10.04 Z M 12,17 L 7,12 H 10 V 8 H 14 V 12 H 17 L 12,17 Z"
                                          Fill="#007AFF" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- Text Block -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource i.downloadFolder}" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{DynamicResource i.localFiles}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="9.5" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <!-- Chevron -->
                                <Path Grid.Column="2" Data="M 8,4 L 14,10 L 8,16" Stroke="#5A5A60" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="7" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Option B: Web URL (YouTube / Spotify) -->
                        <Button x:Name="BtnChoiceUrl" Style="{StaticResource UploadOptionBtn}" ToolTip="{DynamicResource i.downloadFromUrl}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Icon Box -->
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10" Background="#25FF2D55" Margin="0,0,10,0">
                                    <Path Data="M 3.9,12 C 3.9,10.29 5.29,8.9 7,8.9 H 11 V 7 H 7 C 4.24,7 2,9.24 2,12 C 2,14.76 4.24,17 7,17 H 11 V 15.1 H 7 C 5.29,15.1 3.9,13.71 3.9,12 Z M 8,13 H 16 V 11 H 8 V 13 Z M 17,7 H 13 V 8.9 H 17 C 18.71,8.9 20.1,10.29 20.1,12 C 20.1,13.71 18.71,15.1 17,15.1 H 13 V 17 H 17 C 19.76,17 22,14.76 22,12 C 22,9.24 19.76,7 17,7 Z"
                                          Fill="#FF2D55" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- Text Block -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource i.downloadFromUrl}" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{DynamicResource i.autoDetect}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="9.5" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <!-- Chevron -->
                                <Path Grid.Column="2" Data="M 8,4 L 14,10 L 8,16" Stroke="#5A5A60" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="7" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- STEP 2: Direct Smart URL Converter (Auto-detects YouTube & Spotify) -->
                    <StackPanel x:Name="PnlUploadStepUrl" Visibility="Collapsed">
                        <!-- Dynamic Auto-Detection Badge -->
                        <Border x:Name="PnlPlatformBadge" CornerRadius="8" Background="#1CFFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="8,5" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Default Web Icon -->
                                <Path x:Name="IconBadgeNeutral" Grid.Column="0" Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 11,4.07 C 7.05,4.56 4,7.92 4,12 C 4,12.7 4.1,13.38 4.29,14.02 L 9,9.31 V 9 C 9,7.9 9.9,7 11,7 V 4.07 Z M 17.9,8.18 C 17.48,7.47 16.8,6.92 16,6.6 V 7 C 16,8.1 15.1,9 14,9 H 13 V 11 C 13,11.55 12.55,12 12,12 H 10 V 14 H 14 C 15.1,14 16,14.9 16,16 V 16.9 C 18.42,15.68 20,13.06 20,12 C 20,10.55 19.23,9.22 17.9,8.18 Z"
                                      Fill="#8E8E93" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <!-- YouTube Icon (shown when detected) -->
                                <Path x:Name="IconBadgeYoutube" Grid.Column="0" Data="M 21.58,7.19 C 21.35,6.33 20.67,5.65 19.81,5.42 C 18.25,5 12,5 12,5 C 12,5 5.75,5 4.19,5.42 C 3.33,5.65 2.65,6.33 2.42,7.19 C 2,8.75 2,12 2,12 C 2,12 2,15.25 2.42,16.81 C 2.65,17.67 3.33,18.35 4.19,18.58 C 5.75,19 12,19 12,19 C 12,19 18.25,19 19.81,18.58 C 20.67,18.35 21.35,17.67 21.58,16.81 C 22,15.25 22,12 22,12 C 22,12 22,8.75 21.58,7.19 Z M 10,15.5 V 8.5 L 16,12 L 10,15.5 Z"
                                      Fill="#FF0033" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                                <!-- Spotify Icon (shown when detected) -->
                                <Path x:Name="IconBadgeSpotify" Grid.Column="0" Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 16.59,16.59 C 16.39,16.92 15.96,17.02 15.63,16.82 C 12.87,15.13 9.52,14.76 5.58,15.66 C 5.21,15.75 4.84,15.51 4.75,15.14 C 4.66,14.77 4.9,14.4 5.27,14.31 C 9.58,13.33 13.29,13.76 16.36,15.63 C 16.69,15.83 16.79,16.26 16.59,16.59 Z M 17.84,13.48 C 17.59,13.88 17.06,14.01 16.66,13.76 C 13.63,11.89 9.00,11.35 5.39,12.45 C 4.94,12.59 4.46,12.33 4.32,11.88 C 4.18,11.43 4.44,10.95 4.89,10.81 C 9.02,9.56 14.12,10.16 17.56,12.28 C 17.96,12.52 18.09,13.08 17.84,13.48 Z M 17.96,10.27 C 14.32,8.11 8.31,7.91 4.84,8.96 C 4.28,9.13 3.69,8.81 3.52,8.25 C 3.35,7.69 3.67,7.1 4.23,6.93 C 8.22,5.72 14.83,5.95 19.01,8.43 C 19.51,8.73 19.67,9.37 19.37,9.87 C 19.07,10.37 18.46,10.57 17.96,10.27 Z"
                                      Fill="#1DB954" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>

                                <TextBlock x:Name="TxtPlatformBadge" Grid.Column="1" Text="{DynamicResource i.pasteLink}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- URL Input Box with Paste Button -->
                        <Grid Margin="0,0,0,10">
                            <TextBox x:Name="TxtUrlInput" Style="{StaticResource IOSTextBoxStyle}" Height="34" Padding="8,7,30,7"/>
                            <Button x:Name="BtnPasteUrl" Style="{StaticResource MiniIconBtn}" ToolTip="{DynamicResource i.pasteClipboard}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Width="24" Height="24">
                                <Path Data="M 19,2 H 14.82 C 14.4,0.84 13.3,0 12,0 C 10.7,0 9.6,0.84 9.18,2 H 5 C 3.9,2 3,2.9 3,4 V 20 C 3,21.1 3.9,22 5,22 H 19 C 20.1,22 21,21.1 21,20 V 4 C 21,2.9 20.1,2 19,2 Z M 12,2 C 12.55,2 13,2.45 13,3 C 13,3.55 12.55,4 12,4 C 11.45,4 11,3.55 11,3 C 11,2.45 11.45,2 12,2 Z M 19,20 H 5 V 4 H 7 V 7 H 17 V 4 H 19 V 20 Z"
                                      Fill="#8E8E93" Width="11" Height="11" Stretch="Uniform"/>
                            </Button>
                        </Grid>

                        <!-- Action Button: Télécharger & Convertir -->
                        <Button x:Name="BtnStartDownload" Style="{StaticResource UploadActionBtn}" Content="{DynamicResource i.downloadConvert}" Margin="0,0,0,8"/>

                        <!-- Progress / Status Area -->
                        <StackPanel x:Name="PnlUploadProgress" Visibility="Collapsed" Margin="0,2,0,0">
                            <ProgressBar x:Name="UploadProgressBar" Style="{StaticResource IOSProgressBarStyle}" IsIndeterminate="True" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtUploadStatus" Text="{DynamicResource i.analyseLink}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center"/>
                        </StackPanel>

                        <!-- Error Banner (if download fails) -->
                        <TextBlock x:Name="TxtUploadError" Text="" Visibility="Collapsed" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="10" Foreground="#FF453A" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- === CREATE PLAYLIST MODAL OVERLAY === -->
        <Grid x:Name="CreatePlaylistOverlay" Visibility="Collapsed" Panel.ZIndex="120" UseLayoutRounding="True" SnapsToDevicePixels="True">
            <!-- Backdrop Scrim -->
            <Border x:Name="CreatePlaylistBackdrop"
                    Background="#C8000000"
                    CornerRadius="22"
                    Margin="12"
                    IsHitTestVisible="True"/>

            <!-- Card -->
            <Border x:Name="CreatePlaylistCard"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="240"
                    MaxWidth="290"
                    Margin="16,0"
                    CornerRadius="20"
                    Background="{DynamicResource ModalSurfaceBrush}"
                    BorderBrush="#38FFFFFF"
                    BorderThickness="1"
                    Padding="16,14,16,14"
                    UseLayoutRounding="True"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.5" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource i.newPlaylist}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextBrush}" TextAlignment="Center"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button x:Name="BtnCreatePlaylistClose" Style="{StaticResource MiniIconBtn}" ToolTip="{DynamicResource i.close}" HorizontalAlignment="Right">
                            <Path Data="M 4,4 L 16,16 M 16,4 L 4,16" Stroke="#A1A1AA" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <!-- Input Box -->
                    <Grid Margin="0,0,0,12">
                        <TextBox x:Name="TxtPlaylistNameInput" Style="{StaticResource IOSTextBoxStyle}" Height="34" Padding="10,7"/>
                    </Grid>

                    <!-- Action Button -->
                    <Button x:Name="BtnCreatePlaylistConfirm" Style="{StaticResource UploadActionBtn}" Content="{DynamicResource i.createPlaylist}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- === TRACK CONTEXT MENU POPOVER OVERLAY === -->
        <Grid x:Name="ContextMenuOverlay" Visibility="Collapsed" Panel.ZIndex="130" UseLayoutRounding="True" SnapsToDevicePixels="True">
            <!-- Scrim to catch outside click -->
            <Border x:Name="ContextMenuBackdrop" Background="#70000000" CornerRadius="22" Margin="12" IsHitTestVisible="True"/>

            <!-- Popover Card -->
            <Border x:Name="ContextMenuCard"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="210"
                    MaxWidth="270"
                    CornerRadius="16"
                    Background="{DynamicResource ModalSurfaceBrush}"
                    BorderBrush="#38FFFFFF"
                    BorderThickness="1"
                    Padding="8,8,8,8"
                    UseLayoutRounding="True"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.6" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Track Title Preview -->
                    <TextBlock x:Name="TxtContextMenuTrackTitle"
                               Text="{DynamicResource i.track}"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis"
                               TextAlignment="Center"
                               Margin="4,2,4,8"/>

                    <Border Height="1" Background="#20FFFFFF" Margin="0,0,0,6"/>

                    <!-- Option 1: Ajouter à une playlist (Toggle or sub-list) -->
                    <Button x:Name="BtnMenuAddToPlaylist" Style="{StaticResource UploadOptionBtn}" Padding="8,6" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M 14,10 H 2 V 12 H 14 V 10 Z M 14,6 H 2 V 8 H 14 V 6 Z M 2,16 H 10 V 14 H 2 V 16 Z M 18,14 V 10 H 16 V 14 H 12 V 16 H 16 V 20 H 18 V 16 H 22 V 14 H 18 Z"
                                  Fill="#007AFF" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource i.addToPlaylist}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="11" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            <Path x:Name="IconMenuChevron" Grid.Column="2" Data="M 8,4 L 14,10 L 8,16" Stroke="#5A5A60" StrokeThickness="1.5" Width="6" Height="8" Stretch="Uniform" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Playlist Sublist Container (collapsed by default, expands on click) -->
                    <StackPanel x:Name="PnlMenuPlaylistsSublist" Visibility="Collapsed" Margin="6,2,6,6"/>

                    <!-- Option 2: Supprimer -->
                    <Button x:Name="BtnMenuDeleteTrack" Style="{StaticResource UploadOptionBtn}" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M 6,19 C 6,20.1 6.9,21 8,21 H 16 C 17.1,21 18,20.1 18,19 V 7 H 6 V 19 Z M 19,4 H 15.5 L 14.5,3 H 9.5 L 8.5,4 H 5 V 6 H 19 V 4 Z"
                                  Fill="#FF453A" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource i.deleteFile}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="11" Foreground="#FF453A" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
